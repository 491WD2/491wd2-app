# Supabase (local or hosted) — copy to .env.local and restart Vite.
# After `npx supabase start`, run `npx supabase status` for the API URL and anon key.
# Do not commit .env.local. Do not put service-role keys here.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-anon-key

# --- OpenAI (server-side only; used by Netlify Functions — never bundled into Vite) ---
# Set real values in Netlify UI / CLI or your server environment — do not commit secrets.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
#
# OPENAI_API_KEY is server-side only. Never prefix it with VITE_. Never expose it to browser code.
# ChatGPT account passwords / web login are never stored in this app; only API calls from the server.

# Optional: display-only model label in Settings (not secret). Requests use OPENAI_MODEL on the server.
# VITE_AI_MODEL_LABEL=gpt-4.1-mini

# --- Instacart Connect (server-side only; used by netlify/functions/create-instacart-list — never VITE_*) ---
# INSTACART_API_KEY=
# Production default is https://connect.instacart.com; development keys often use https://connect.dev.instacart.tools
# INSTACART_CONNECT_BASE_URL=https://connect.instacart.com
